APP_ENV=development
MODE=development
PORT=5000
HOST=127.0.0.1
NUXT_PUBLIC_BASE_URL=http://127.0.0.1:5000
NUXT_PUBLIC_API_URL="http://127.0.0.1:3000/api/v1"
NUXT_PUBLIC_API_SOCKET_URL="ws://127.0.0.1:3000/api/v1/socket"
NUXT_PUBLIC_KRATOS_URL="http://127.0.0.1:4433"
NUXT_PUBLIC_MAX_IMAGE_FILE_SIZE=512000 # bytes (500 KB). Fallback cap applied only to formats the browser cannot resize (GIF, HEIC on Chrome/Firefox), which are stored as-is.
NUXT_PUBLIC_MAX_IMAGE_UPLOAD_SIZE=10485760 # bytes (10 MB). Ceiling on the file a user may pick; it is downscaled to 800px WebP before being stored.
NUXT_PUBLIC_PRIVILEGED_SESSION_MAX_AGE=15 #in minutes